# Environment of the testing stack.
# scripts/init.sh writes .env from this file: it sets the ###CHANGEME### values, and keeps the other
# values of an existing .env, so they can be changed there.
# Without init.sh: copy this file to .env and replace every ###CHANGEME### value.

# System variables
## Output of the command "id -u"
UID=###CHANGEME_UID###
## Output of the command "id -g"
GID=###CHANGEME_GID###
## Group owning the Docker socket, as seen from the containers (0 on Docker Desktop)
docker_gid=###CHANGEME_DOCKER_GID###
## Network of the stack. Change these values together if the subnet overlaps an existing network,
## then recreate the stack (docker compose down).
stack_subnet=172.30.0.0/24
## Range used for the containers without a fixed address
stack_ip_range=172.30.0.128/25
## Fixed addresses, the only ones allowed by the egress guard of TheHive Flow
thehive_ip=172.30.0.10
cortex_ip=172.30.0.11
thehive_flow_ip=172.30.0.12

# ElasticSearch password (regenerated by init.sh)
elasticsearch_password='###CHANGEME_ELASTICSEARCH_PASSWORD###'

# Nginx configuration
nginx_server_name="###CHANGEME_SERVER_NAME###"
nginx_ssl_trusted_certificate=""

# Cortex specific configuration
cortex_docker_job_directory=${PWD}/cortex/cortex-jobs
## Password of the Cortex superadmin "admin", set by init.sh when it creates it.
## Same default as TheHive (admin@thehive.local / secret).
cortex_admin_password=secret

# TheHive Flow configuration (secrets are kept when init.sh is run again)
postgres_password=###CHANGEME_POSTGRES_PASSWORD###
flow_db_password=###CHANGEME_FLOW_DB_PASSWORD###
temporal_db_password=###CHANGEME_TEMPORAL_DB_PASSWORD###
s3_access_key_id=thehive-flow
s3_secret_access_key=###CHANGEME_S3_SECRET_ACCESS_KEY###
## Same value as flow.jwt_signing_key in TheHive
jwt_signing_key=###CHANGEME_JWT_SIGNING_KEY###
## When empty, read from ./thehive-flow/secret/thehive-api-key (written by init.sh)
thehive_api_key=
flow_thehive_url=http://thehive:9000/thehive
flow_public_url=https://###CHANGEME_SERVER_NAME###/flow
