# Generated by scripts/init.sh from dot.env.template.
# Secrets below are generated once and kept when init.sh is run again:
# changing them on an initialised stack breaks database and TheHive authentication.

# PostgreSQL passwords (superuser, TheHive Flow database user, Temporal database user)
postgres_password=###CHANGEME_POSTGRES_PASSWORD###
flow_db_password=###CHANGEME_FLOW_DB_PASSWORD###
temporal_db_password=###CHANGEME_TEMPORAL_DB_PASSWORD###

# S3 object store credentials
s3_access_key_id=thehive-flow
s3_secret_access_key=###CHANGEME_S3_SECRET_ACCESS_KEY###

# JWT signing key shared with TheHive: set the same value in TheHive (TH_ORCHESTRATOR_KEY)
jwt_signing_key=###CHANGEME_JWT_SIGNING_KEY###

# TheHive URL reachable from the TheHive Flow container, e.g. http://192.168.1.10:9000
flow_thehive_url=###CHANGEME_FLOW_THEHIVE_URL###
# TheHive API key used by TheHive Flow. Leave empty to read ./thehive-flow/secret/thehive-api-key
thehive_api_key=###CHANGEME_THEHIVE_API_KEY###
# Public URL of this server, used to build webhook URLs
flow_public_url=###CHANGEME_FLOW_PUBLIC_URL###
